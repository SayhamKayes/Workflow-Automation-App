# ==========================================
# LogCrafter - Environment Variables Template
# ==========================================

# 1. Google OAuth 2.0 Client ID (Optional for Demo Mode, Required for Real Google Sign-In)
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# e.g., 123456789-abcdefghijk.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=""

# 2. Google Apps Script Web App URL (Optional fallback)
VITE_APPS_SCRIPT_URL=""

# 3. Gemini API Key (If using AI assistant features)
VITE_GEMINI_API_KEY=""
